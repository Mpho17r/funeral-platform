# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://funeralos:CHANGE-ME@localhost:5432/funeralos
# At least 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# development (default) or production. Production refuses unsafe settings.
APP_ENV=development
# Your web address(es), comma separated. Required in production, https only.
CORS_ORIGINS=

# Instant call links (use your own Jitsi server for sensitive work).
CALL_BASE_URL=https://meet.jit.si

# Backups and scheduler
BACKUP_DIR=backups
BACKUP_KEEP=14
SCHEDULER_TIMEZONE=Africa/Johannesburg
SCHEDULER_BACKUP_HOUR=2
SCHEDULER_REMINDERS_HOUR=7
SCHEDULER_BACKUPS_ENABLED=true
