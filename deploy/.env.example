# Copy to deploy/.env and fill in. Never commit the real file.

# Your two web addresses (both must point at the server before first start).
APP_DOMAIN=app.yourfuneralhome.co.za
API_DOMAIN=api.yourfuneralhome.co.za

# Strong random values:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
JWT_SECRET_KEY=

# Optional: email sending (see docs/MESSAGE_DELIVERY.md)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
