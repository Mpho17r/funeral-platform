# Copy this file to deploy/offsite.env on the production VPS.
# Keep deploy/offsite.env private (chmod 600); never commit real credentials.
OFFSITE_BACKUP_ENABLED=false

# Example format only. Replace with your private B2 bucket's actual region/name.
RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket-name>/linda/production
RESTIC_PASSWORD=replace-with-a-long-random-password-stored-in-a-password-manager
AWS_ACCESS_KEY_ID=replace-with-b2-application-key-id
AWS_SECRET_ACCESS_KEY=replace-with-b2-application-key
AWS_DEFAULT_REGION=<region>
